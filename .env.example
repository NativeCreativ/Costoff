# Copy to .env (gitignored) and replace every placeholder before `docker compose up`.
# Do not commit .env. Generate SESSION_SECRET on the host; do not reuse an old value.
#
#   openssl rand -base64 48
#
# POSTGRES_PASSWORD must be URL-safe (letters and numbers). Compose embeds it in DATABASE_URL.
# The app container's DATABASE_URL is not read from the DATABASE_URL line below.
# Compose sets it to:
#   postgresql://POSTGRES_USER:POSTGRES_PASSWORD@costaff-ats-db:5432/POSTGRES_DB

POSTGRES_USER=costaff
POSTGRES_PASSWORD=replace-with-a-url-safe-password
POSTGRES_DB=costaff_ats

# Shape only. Docker Compose overwrites this for costaff-ats-app.
DATABASE_URL=postgresql://costaff:replace-with-a-url-safe-password@costaff-ats-db:5432/costaff_ats

# openssl rand -base64 48
SESSION_SECRET=replace-with-output-of-openssl-rand-base64-48

# Optional. Leave unset. The session cookie is Secure only when the request is HTTPS
# (the page itself, or the first x-forwarded-proto value). Plain HTTP, including this
# production image on an HTTP test host, stores the cookie without Secure.
# Set true or false only when that detection is wrong.
# COOKIE_SECURE=

# Optional. Mail is simulated in the logs when these are empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Host port published for the app. The process inside the container listens on 3000.
COSTAFF_ATS_PORT=3000
